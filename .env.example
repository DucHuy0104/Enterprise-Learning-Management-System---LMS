# Cấu hình PostgreSQL (Docker Local)
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=lms_password
POSTGRES_DB=corporate_lms
POSTGRES_PORT=5432

# Cấu hình Redis (Docker Local)
REDIS_PORT=6379

# Chuỗi kết nối chuẩn cho Prisma ORM (Copy vào file backend/.env)
DATABASE_URL="postgresql://lms_user:lms_password@localhost:5432/corporate_lms?schema=public"
REDIS_URL="redis://localhost:6379"